# Public production URL (no trailing slash). Used for canonical URLs, hreflang, sitemap and OG tags.
# Leave unset on Vercel to use the project's production domain automatically (now mia-robotics.vercel.app).
# Set it once the custom domain is live.
NEXT_PUBLIC_SITE_URL=

# Contact form delivery (Resend — https://resend.com). All three are required, otherwise the form
# returns an error and NEVER shows a false success message.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Verified investors address. Leave empty to route investors through the contact form instead.
NEXT_PUBLIC_INVESTORS_EMAIL=

# Public contact email shown in the closing "See it in the field" section. Empty = hidden.
NEXT_PUBLIC_CONTACT_EMAIL=

# Lead storage (every request + its news-updates consent and timestamp). On Vercel, add
# "Upstash for Redis" from the Marketplace: it sets KV_REST_API_URL and KV_REST_API_TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Password for the CSV export at /api/leads/export (any username). Empty = export disabled.
LEADS_EXPORT_PASSWORD=
