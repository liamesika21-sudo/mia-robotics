# Public production URL (no trailing slash). Used for canonical URLs, hreflang, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery (Resend — https://resend.com). All three are required, otherwise the form
# returns an error and NEVER shows a false success message.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Verified investors address. Leave empty to route investors through the contact form instead.
NEXT_PUBLIC_INVESTORS_EMAIL=

# Public contact email shown in the closing "See it in the field" section. Empty = hidden.
NEXT_PUBLIC_CONTACT_EMAIL=
